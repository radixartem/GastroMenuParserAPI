hcloud_token   = "ваш_токен"
location       = "nbg1"
ssh_key_name   = "main"
project_name   = "gastro"
environment    = "production"

servers = {
  production = {
    server_type    = "cpx21"
    image          = "ubuntu-24.04"
    attach_volume  = true
    prevent_destroy = true
  }
  stage = {
    server_type    = "cpx11"
    image          = "ubuntu-24.04"
    attach_volume  = false
    prevent_destroy = false
  }
}

# Используем существующий файрвол
firewall_id = 123456   # замените на реальный ID

# Сеть не создаём (для одного сервера не нужна)
create_network = false

# Создаём том для PostgreSQL
create_volume   = true
volume_name     = "postgres-data-prod"
volume_size_gb  = 20

deploy_user = "deploy"
github_user = "your-github-username"   # опционально
ansible_repo = "https://github.com/your-org/gastro-api.git"
ansible_branch = "main"